{
  "name": "media-art-workbench",
  "version": "2.0",
  "description": "媒体艺术智能工作台 - 项目全生命周期管理工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3004 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "pack": "electron-builder --dir",
    "lint": "eslint src --ext .js,.vue",
    "lint:quiet": "eslint src --ext .js,.vue --quiet",
    "check:static": "node scripts/check-static.mjs",
    "check:params": "node scripts/check-params.mjs",
    "check:deadcode": "node scripts/check-deadcode.mjs",
    "check": "npm run check:static && npm run check:params && npm run check:deadcode",
    "lint:fix": "eslint src --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\"",
    "test": "node tests/run.js",
    "test:watch": "node tests/run.js --watch"
  },
  "author": "MediaArt Team",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.8.1",
    "terser": "^5.24.0",
    "vite": "^5.4.21",
    "vite-plugin-static-copy": "^3.3.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.mediaart.workbench",
    "productName": "媒体艺术智能工作台",
    "asar": false,
    "directories": {
      "output": "dist-output-final"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/vite/**",
      "!node_modules/terser/**",
      "!node_modules/concurrently/**",
      "!node_modules/wait-on/**"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs",
      "type": "commonjs",
      "scripts": {},
      "devDependencies": {}
    },
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*",
          "!backup/**/*"
        ]
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "MediaArt_Archives",
        "to": "MediaArt_Archives"
      },
      {
        "from": "templates",
        "to": "templates"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "媒体艺术智能工作台"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.exe"
    }
  }
}
